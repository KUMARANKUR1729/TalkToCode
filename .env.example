# Copy to .env and fill in. .env is gitignored; never commit a real key.
NVIDIA_API_KEY=nvapi-your-key-here

# Chat model used to phrase answers. Run `python -m graphify.check_models` to
# see what your key can actually reach — hosted models get retired.
# nvidia/nemotron-3-super-120b-a12b gives richer answers but is slow and often
# overloaded; the app falls back automatically when a model is unavailable.
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Embedding model for semantic retrieval.
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# auto | embeddings | llm | off
#   auto       try embeddings, fall back to asking the chat model
#   off        lexical retrieval only, no network calls during retrieval
GRAPHIFY_SEMANTIC=auto

# Optional tuning
GRAPHIFY_TIMEOUT=120
GRAPHIFY_MAX_RETRIES=3
GRAPHIFY_MAX_NODES=5
