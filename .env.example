# Local development template only. Production must use managed secrets/workload identity.
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# Egress is deny-by-default. Set true only after repository/model use is approved.
GRAPHIFY_ALLOW_EXTERNAL_LLM=false
GRAPHIFY_ALLOWED_LLM_HOSTS=integrate.api.nvidia.com
GRAPHIFY_SEMANTIC=off
# Browser-entered keys are intentionally disabled; prefer environment/secret injection.
GRAPHIFY_ALLOW_BROWSER_API_KEY=false

# development | test | production. Production refuses startup unless an authenticated
# upstream authorization boundary is explicitly acknowledged.
GRAPHIFY_ENV=development
GRAPHIFY_TRUSTED_AUTH_BOUNDARY=false
GRAPHIFY_ALLOW_UI_REBUILD=true
GRAPHIFY_REQUIRE_ARTIFACT_CHECKSUM=false

# Bounded retries, questions, graph context, input files and artifacts.
GRAPHIFY_TIMEOUT=60
GRAPHIFY_MAX_RETRIES=3
GRAPHIFY_MAX_NODES=5
GRAPHIFY_MAX_QUESTION_CHARS=4000
GRAPHIFY_MAX_SNIPPET_CHARS=20000
GRAPHIFY_MAX_MODEL_INPUT_CHARS=150000
GRAPHIFY_MAX_MODEL_OUTPUT_TOKENS=2000
GRAPHIFY_MAX_SOURCE_FILES=10000
GRAPHIFY_MAX_SOURCE_FILE_BYTES=5000000
GRAPHIFY_MAX_REPOSITORY_BYTES=1000000000
GRAPHIFY_MAX_GRAPH_BYTES=250000000
GRAPHIFY_MAX_GRAPH_NODES=1000000
GRAPHIFY_MAX_GRAPH_EDGES=3000000
GRAPHIFY_INDEX_CACHE_SIZE=8
GRAPHIFY_ARTIFACT_LOCK_TIMEOUT=30
GRAPHIFY_ARTIFACT_LOCK_STALE_AFTER=900

# Override only for an approved compatible model gateway; HTTPS is mandatory.
# GRAPHIFY_CHAT_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions
# GRAPHIFY_EMBED_ENDPOINT=https://integrate.api.nvidia.com/v1/embeddings
# GRAPHIFY_MODELS_ENDPOINT=https://integrate.api.nvidia.com/v1/models
